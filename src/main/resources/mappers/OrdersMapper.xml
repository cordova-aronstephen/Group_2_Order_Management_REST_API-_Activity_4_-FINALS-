<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.pup.taguig.app.repository.OrdersMapper">

	<resultMap id="ordersResultMap" type="com.pup.taguig.app.model.Orders">
	    <id     property="id"              column="id"/>
	    <result property="customerId"      column="customer_id"/>
	    <result property="totalQuantity"   column="total_quantity"/>
	    <result property="statusId"        column="status_id"/>
	    <result property="orderPriceTotal" column="order_price_total"/>
	    <result property="createdAt"       column="created_at"/>
	</resultMap>
	
	<resultMap id="orderItemResultMap" type="com.pup.taguig.app.model.OrderItem">
	    <id     property="id"         column="id"/>
	    <result property="orderId"    column="order_id"/>
	    <result property="productId"  column="product_id"/>
	    <result property="totalPrice" column="total_price"/>
	    <result property="quantity"   column="quantity"/>
	    <result property="createdAt"  column="created_at"/>
	</resultMap>
	
	<resultMap id="statusResultMap"
		type="com.pup.taguig.app.model.Status">
			<id property="id" column="id"/>
			<result property="name" column="name"/>
			<result property="created_at" column="createdAt"/>
	</resultMap>
	
	<insert id="insertOrder" keyProperty="id" useGeneratedKeys="true">
		INSERT INTO orders 
			(customer_id, 
				total_quantity, 
				status_id, 
				order_price_total)
		VALUES
			(#{customerId}, 
				#{totalQuantity}, 
				#{statusId}, 
				#{orderPriceTotal})
	</insert>
	
	<insert id="insertOrderItem" keyProperty="id" useGeneratedKeys="true">
		INSERT INTO order_item
			(order_id, product_id, total_price, quantity)
		VALUES
			(#{orderId}, #{productId}, #{totalPrice}, #{quantity})
	</insert>
	
	<select id="getOrderById" resultMap="ordersResultMap">
		SELECT
			*
		FROM 
			orders
		WHERE 
			id=#{id}
	</select>
	
	<select id="getOrderItemByOrderIdAndProductId" resultMap="orderItemResultMap">
		SELECT
			*
		FROM
			order_item
		WHERE 
			(product_id = #{productId}) AND
			(order_id = #{orderId})
	</select>

	<select  id="retrieveAllOrderItemByOrderId" resultMap="orderItemResultMap">
		SELECT
			*
		FROM
			order_item
		WHERE 
			(order_id = #{orderId})
	</select>
	
	<delete id="deleteOrderById">
		DELETE FROM orders
			WHERE id=#{id}
	</delete>
	
	<select  id="retrieveAllOrdersByCustomerId" resultMap="ordersResultMap">
		SELECT
			*
		FROM
			orders
		WHERE 
			(customer_id = #{customerId})
	</select>
	
</mapper>