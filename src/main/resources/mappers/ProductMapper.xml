<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.pup.taguig.app.repository.ProductMapper">

	<resultMap id="ProductResultMap" type="com.pup.taguig.app.model.Product">
		<id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="description" column="description"/>
        <result property="price" column="price"/>
        <result property="stock" column="stock"/>
	</resultMap>
	
	<insert id="insertProduct"
            parameterType="com.pup.taguig.app.model.Product"
            useGeneratedKeys="true"
            keyProperty="id">
        INSERT INTO product 
        	(name, description, price, stock)
        VALUES 
        	(#{name}, #{description}, #{price}, #{stock})
    </insert>
    
    <select id="findById" 
    			parameterType="long" 
    			resultMap="ProductResultMap">
        SELECT 
        	id, 
       		name, 
       		description, 
       		price, 
       		stock
        FROM 
        	product
        WHERE 
        	id = #{id}
    </select>
    
    <select id="findAllProducts" 
    			resultMap="ProductResultMap">
        SELECT 
        	id, 
       		name, 
       		description, 
       		price, 
       		stock
        FROM 
        	product
        ORDER BY 
        	id ASC
    </select>
    
    <select id="findProductsPaged" 
    			resultMap="ProductResultMap">
        SELECT 
        	id, 
       		name, 
     		description, 
     		price, 
     		stock
        FROM 
        	product
        ORDER BY 
        	id ASC
        LIMIT 
        	#{limit} OFFSET #{offset}
    </select>
    
    <select id="countAllProducts" resultType="int">
        SELECT 
        	COUNT(*) 
       	FROM 
       		product
    </select>
    
    <update id="decreaseStock">
        UPDATE 
        	product
        SET 
        	stock = stock - #{quantity}
        WHERE 
        	id = #{productId}
    </update>

</mapper>
